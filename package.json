{
  "name": "filarr-extension-builder",
  "private": true,
  "description": "Outils publics pour créer, tester et empaqueter des extensions Filarr — avec ou sans code.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/code/*",
    "examples/nocode/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "check:examples": "npm run check --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "esbuild": "^0.24.2",
    "fflate": "^0.8.2",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8",
    "yjs": "^13.6.20"
  }
}
