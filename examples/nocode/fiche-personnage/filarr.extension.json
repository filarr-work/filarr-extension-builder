{
  "manifest": {
    "id": "fiche-personnage",
    "name": "Fiche de personnage",
    "version": "1.0.0",
    "description": "Une fiche de personnage de jeu de rôle : classe, niveau, points de vie, caractéristiques en barres, traits, inventaire et histoire.",
    "extensions": [
      "perso"
    ],
    "icon": "🧙",
    "category": "fun",
    "author": "Filarr Builder (exemple)",
    "capabilities": {
      "newDocument": [
        {
          "ext": "perso",
          "label": "Nouveau personnage",
          "seed": ""
        }
      ],
      "functions": {
        "extractText": true,
        "fields": [
          {
            "key": "niveau",
            "label": "Niveau",
            "type": "number"
          },
          {
            "key": "classe",
            "label": "Classe",
            "type": "text"
          }
        ]
      }
    }
  },
  "listing": {
    "releaseNotes": "Exemple du Filarr Extension Builder.",
    "license": "MIT"
  },
  "screenshots": [],
  "build": {
    "kind": "nocode",
    "config": "nocode.json"
  }
}
