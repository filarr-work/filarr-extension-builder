{
  "name": "@filarr/nocode-engine",
  "version": "1.0.1",
  "description": "Le moteur sans code des extensions Filarr : une configuration déclarative devient un éditeur complet, et le bundle au format .filarrext.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/filarr-work/filarr-extension-builder.git",
    "directory": "packages/nocode-engine"
  },
  "homepage": "https://github.com/filarr-work/filarr-extension-builder#readme",
  "bugs": {
    "url": "https://github.com/filarr-work/filarr-extension-builder/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "filarr-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./engine.js": "./dist/engine.js",
    "./scripts/engine.mjs": "./scripts/engine.mjs",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "scripts/engine.mjs",
    "scripts/engine.d.mts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@filarr/extension-api": "1.0.1"
  },
  "keywords": [
    "filarr",
    "extension",
    "nocode"
  ],
  "publishConfig": {
    "access": "public"
  }
}
